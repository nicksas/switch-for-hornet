<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:colorAccent">#5CD888</item>
        <item name="android:colorPrimary">#0B0C10</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#0B0C10</item>
        <item name="android:navigationBarColor">#0B0C10</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">#5CD888</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>
